<div {{ attributes }}>
    <h2 class="text-center">{{ type.title }}</h2>
    {% if type.hasAuthorLabels %}
        <div {{ stimulus_controller('chart-author-filter', {otherUsersLabel: constant('App\\Repository\\QotdRepository::OTHER_USERS_LABEL')}) }} {{ stimulus_action('chart-author-filter', 'connectChart', 'chartjs:connect') }}>
            {{ render_chart(this.chart) }}
        </div>
    {% else %}
        {{ render_chart(this.chart) }}
    {% endif %}
</div>

{% macro placeholder(props) %}
    <h2 class="text-center">{{ props.type.title }}</h2>
    <p class="placeholder-glow text-center"><span class="placeholder col-6"></span></p>
{% endmacro %}
