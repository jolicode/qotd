<div {{ attributes }}>
    <h2 class="h5 text-center">{{ 'Number of QOTD Vote over a period'|trans }}</h2>

    <ul class="nav nav-tabs mb-3">
        {% for statsPeriod in enum_cases('App\\Stats\\StatsPeriod') %}
            <li class="nav-item">
                <button
                    type="button"
                    class="{{ html_classes('nav-link', {active: statsPeriod == period}) }}"
                    {{ live_action('showPeriod', {period: statsPeriod.value}) }}
                >{{ statsPeriod.label|trans }}</button>
            </li>
        {% endfor %}
    </ul>

    <div class="row" data-loading="addClass(opacity-50)">
        {% for chart in this.charts %}
            <div class="col-lg-6">
                {{ render_chart(chart, {role: 'img', 'aria-label': chart.options.plugins.title.text}) }}
            </div>
        {% endfor %}
    </div>
</div>

{% macro placeholder(props) %}
    <p class="placeholder-glow text-center"><span class="placeholder col-6"></span></p>
{% endmacro %}
