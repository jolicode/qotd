{% import 'macros/qotd/message.html.twig' as qotd_macro %}

<div {{ attributes.defaults({class: 'card mb-2 qotd-card', 'data-controller': 'ui--clipboard'}) }} data-qotd-id="{{ qotd.id }}" {{ stimulus_target('not-voted-list', 'card') }} {{ tt('quote') }}>
    <div class="card-body" {{ stimulus_target('ui--clipboard', 'source') }}>
        {{ qotd_macro.message(qotd) }}
        {% for imageUrl in qotd.imageUrls %}
            <twig:ux:image :src="asset(imageUrl)" alt="" width="1000" />
        {% endfor %}
        {% for videoUrl in qotd.videoUrls %}
            <video class="mw-100" controls>
                <source src="{{ asset(videoUrl) }}" />
            </video>
        {% endfor %}
    </div>
    <div class="card-footer text-muted">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a href="{{ url('qotd_show', {id: qotd.id}) }}" class="text-reset">
                {{ '%date% by %author%'|trans({'%date%': qotd.date|date('Y-m-d'), '%author%': qotd.username}) }}
            </a>
            <a href="{{ qotd.permalink }}" class="btn btn-sm btn-outline-secondary">🔗 {{ 'view in Slack'|trans }}</a>

            <div class="d-flex align-items-center gap-3 ms-auto">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-link btn-sm p-0 text-reset" title="{{ 'Copy the QOTD'|trans }}" {{ stimulus_action('ui--clipboard', 'copy') }} {{ tt('copy') }}>
                        <span {{ stimulus_target('ui--clipboard', 'idle') }}><twig:ux:icon name="bi:clipboard" /></span>
                        {# "hidden" in the HTML: the controller only sets it on connect, a Live re-render would remove it #}
                        <span {{ stimulus_target('ui--clipboard', 'success') }} hidden><twig:ux:icon name="bi:clipboard-check" /></span>
                    </button>
                    <a href="{{ url('qotd_show_details', {id: qotd.id}) }}" class="text-reset" data-turbo-frame="modal"><twig:ux:icon name="bi:info-circle" /></a>
                    <a href="{{ url('qotd_show_edit', {id: qotd.id}) }}" class="text-reset" data-turbo-frame="modal"><twig:ux:icon name="bi:pencil" /></a>
                    <a href="{{ url('qotd_show_images', {id: qotd.id}) }}" class="text-reset" data-turbo-frame="modal" title="{{ 'Add images'|trans }}"><twig:ux:icon name="bi:image" /></a>
                </div>
                <div class="d-flex align-items-center gap-1">
                    {% set in_my_top = this.myTop.has(qotd) %}
                    <button
                        type="button"
                        class="btn btn-link btn-sm p-0 me-1 text-reset"
                        title="{{ (in_my_top ? 'Remove from my top' : 'Add to my top')|trans }}"
                        {{ live_action('toggleMyTop') }}
                        {# data-loading removes the "disabled" attribute once loaded, they cannot be used together #}
                        {% if not in_my_top and this.myTop.full %}disabled{% else %}data-loading="addAttribute(disabled)"{% endif %}
                        {{ tt('my-top-toggle') }}
                    ><twig:ux:icon :name="in_my_top ? 'bi:star-fill' : 'bi:star'" /></button>
                    <button
                        type="button"
                        class="{{ html_classes('btn', 'btn-sm', 'qotd-vote-down', {'btn-outline-primary': qotd.hasVotedDown(app.user)}) }}"
                        {{ qotd.hasVotedDown(app.user) ? live_action('resetVote') : live_action('vote', {vote: 'down'}) }}
                        data-loading="addAttribute(disabled)"
                        {{ tt('vote-down') }}
                    >👎</button>
                    <div class="badge bg-primary" {{ tt('quote-vote') }}>
                        <span class="qotd-vote">{{ qotd.vote }}</span>
                        <twig:ux:icon name="bi:eye-slash-fill" class="qotd-vote-hidden align-middle" />
                    </div>
                    <button
                        type="button"
                        class="{{ html_classes('btn', 'btn-sm', 'qotd-vote-up', {'btn-outline-primary': qotd.hasVotedUp(app.user)}) }}"
                        {{ qotd.hasVotedUp(app.user) ? live_action('resetVote') : live_action('vote', {vote: 'up'}) }}
                        data-loading="addAttribute(disabled)"
                        {{ tt('vote-up') }}
                    >👍</button>
                </div>
            </div>
        </div>
    </div>
</div>
