<div {{ attributes }}>
    {{ form_start(form, {attr: {
        id: 'qotd-edit',
        'data-action': 'live#action:prevent',
        'data-live-action-param': 'save',
        'data-model': 'debounce(200)|*',
    }}) }}
        {{ form_row(form.context) }}
        <div class="{{ html_classes('form-text', 'text-end', {'text-danger': this.remainingContextLength < 0}) }}" {{ tt('context-remaining') }}>
            {{ '%count% characters left'|trans({'%count%': this.remainingContextLength}) }}
        </div>
    {{ form_end(form) }}
</div>
