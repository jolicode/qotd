{% extends 'unique_block.html.twig' %}

{# We defined commonly overriden modal block, feel free to add more #}
{% block title '' %}
{% block body '' %}
{% block modal_footer_pre '' %}
{% block modal_footer_post '' %}

{% block unique_block %}
    <turbo-frame id="{{ get_turbo_frame() }}">
        {% if 'modal' == get_turbo_frame() %}
            {% block modal %}
                {% set modal_title %}{{ block('title') }}{% endset %}
                {% set modal_body %}{{ block('body') }}{% endset %}
                {% set modal_footer_pre %}{{ block('modal_footer_pre') }}{% endset %}
                {% set modal_footer_post %}{{ block('modal_footer_post') }}{% endset %}
                {# do NOT use fade here, it mess up JS (race concurrence, 💥) #}
                {% component 'ui:Modal' with {id: 'qotd-modal', size: 'lg', fade: false, 'data-modal-target': 'bsModal', ...(modal_attributes ?? {})} %}
                    {% block content %}
                        <twig:ui:Modal:Header>
                            <twig:ui:Modal:Title>{{ modal_title }}</twig:ui:Modal:Title>
                        </twig:ui:Modal:Header>
                        <twig:ui:Modal:Body>{{ modal_body }}</twig:ui:Modal:Body>
                        <twig:ui:Modal:Footer>
                            {{ modal_footer_pre }}
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            {{ modal_footer_post }}
                        </twig:ui:Modal:Footer>
                    {% endblock %}
                {% endcomponent %}
            {% endblock %}
        {% else %}
            {{ block('body') }}
        {% endif %}

        {% block toasts %}
            {% for flash in app.flashes('success') %}
                <turbo-stream action="append" target="toasts">
                    <template>
                        <twig:ui:Toast :show="false" role="alert" live="assertive" data-controller="toast">
                            <twig:ui:Toast:Header title="✅ Saved!" />
                            <twig:ui:Toast:Body>{{ flash }}</twig:ui:Toast:Body>
                        </twig:ui:Toast>
                    </template>
                </turbo-stream>
            {% endfor %}
        {% endblock %}

        {% block frames '' %}
    </turbo-frame>
{% endblock %}
