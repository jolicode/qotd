{% extends 'base_with_frame.html.twig' %}

{% import 'macros/qotd/message.html.twig' as qotd_macro %}

{% block title %}QOTD #{{ qotd.id }}{% endblock %}

{% block body %}
    <table class="table table-striped table-sm">
        <tr>
            <th>ID</th>
            <td>
                {{ qotd.id }}
                <a href="{{ url('qotd_show_details', {id: qotd.id}) }}" class="text-reset" data-turbo-frame="modal"><twig:ux:icon name="bi:info-circle" /></a>
            </td>
        </tr>
        <tr>
            <th>{{ 'Raw Message'|trans }}</th>
            <td>
                <div class="overflow-x-scroll" style="max-width:calc(var(--bs-modal-width) - 10em)">
                    <pre><code>{{ qotd.message|nl2br }}</code></pre>
                </div>
            </td>
        </tr>
        {% if qotd.messageRendered %}
            <tr>
                <th>{{ 'Raw Message Renderer'|trans }}</th>
                <td>
                    <div class="overflow-x-scroll" style="max-width:calc(var(--bs-modal-width) - 10em)">
                        <pre><code>{{ qotd.messageRendered|nl2br }}</code></pre>
                    </div>
                </td>
            </tr>
        {% endif %}
        <tr>
            <th>{{ 'Raw Context'|trans }}</th>
            <td>
                <div class="overflow-x-scroll" style="max-width:calc(var(--bs-modal-width) - 10em)">
                    <pre><code>{{ qotd.context|nl2br }}</code></pre>
                </div>
            </td>
        </tr>
        <tr>
            <th>{{ 'Message'|trans }}</th>
            <td>{{ qotd_macro.message(qotd) }}</td>
        </tr>
        <tr>
            <th>{{ 'Images'|trans }}</th>
            <th>
                {% for image in qotd.imageUrls %}
                    {% set url = asset(image) %}
                    <a href="{{ url }}" target="_blank">
                        <twig:ux:image :src="url" alt="" width="100" height="100" fit="contain" />
                    </a>
                {% else %}
                    {{ 'None'|trans }}
                {% endfor %}
            </th>
        </tr>
        <tr>
            <th>{{ 'Videos'|trans }}</th>
            <th>
                {% for video in qotd.videoUrls %}
                    <video controls width="250">
                        <source src="{{ asset(video) }}" />
                    </video>
                {% else %}
                    {{ 'None'|trans }}
                {% endfor %}
            </th>
        </tr>
        <tr>
            <th>{{ 'Date'|trans }}</th>
            <td>{{ qotd.date|date('Y-m-d') }}</td>
        </tr>
        <tr>
            <th>{{ 'Author'|trans }}</th>
            <td>{{ qotd.username }}</td>
        </tr>
        <tr>
            <th>{{ 'Permalink (on this app)'|trans }}</th>
            <td><a href="{{ url('qotd_show', {id: qotd.id}) }}">{{ url('qotd_show', {id: qotd.id}) }}</a></td>
        </tr>
        <tr>
            <th>{{ 'Permalink (on slack)'|trans }}</th>
            <td><a href="{{ qotd.permalink }}">{{ qotd.permalink }}</a></td>
        </tr>
        <tr>
            <th>{{ 'Vote'|trans }}</th>
            <td>{{ qotd.vote }}</td>
        </tr>
        <tr>
            <th>{{ 'Voters'|trans }}</th>
            <td>{{ qotd.voterIds|keys|join(', ') }}</td>
        </tr>
    </table>
{% endblock %}
