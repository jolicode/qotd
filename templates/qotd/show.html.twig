{% extends 'base_with_frame.html.twig' %}

{% block title %}QOTD #{{ qotd.id }}{% endblock %}

{% block body %}
    <twig:QotdCard :qotd="qotd" />
{% endblock %}

{# We use this template as the "finish point" of diverse operations, that may occurs in modals #}
{# So we clean the template, then replace a potentials frames #}

{% block modal '' %}

{% block frames %}
    <turbo-stream action="replace" target="qotd-{{ qotd.id }}">
        <template>
            <twig:QotdCard :qotd="qotd" />
        </template>
    </turbo-stream>
{% endblock %}
