{% extends 'base.html.twig' %}

{% if form ?? false %}
    {% form_theme form 'bootstrap_5_horizontal_layout.html.twig' %}
{% endif %}

{% set active = direction.toTwigActiveSection %}
{% set live_updates_topics = [constant('App\\Qotd\\LiveUpdates::VOTES_TOPIC'), constant('App\\Qotd\\LiveUpdates::LATEST_TOPIC')] %}

{% block title %}{{ direction.toTitle|trans }}{% endblock %}

{% block body %}
    <div id="qotd-latest-banner"></div>

    {% if form ?? false %}
        <details {{ valid ? 'open' }}>
            <summary class="qotd-filters-toggle btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2 mb-2">
                <twig:ux:icon name="bi:funnel" />
                {{ 'Filters'|trans }}
                <twig:ux:icon name="bi:chevron-down" class="qotd-filters-chevron" />
            </summary>
            {# Permanent: morphing would remove the DOM added by Tom Select #}
            <div id="qotd-filters-container" class="mb-3" data-turbo-permanent {{ stimulus_controller('form-auto-submit') }}>
                {{ form(form, {attr: {id: 'qotd-filters', 'data-turbo-action': 'replace'}}) }}
                <noscript>
                    <button type="submit" class="btn btn-primary" form="qotd-filters">{{ 'Filters'|trans }}</button>
                </noscript>
            </div>
        </details>
    {% endif %}

    <div {{ 'qotd_not_voted' == active ? stimulus_controller('not-voted-list', {url: path('qotd_index_not_voted')}) }}>
        {% for qotd in pagination %}
            <twig:QotdCard :qotd :direction />
        {% else %}
            <div class="card mb-2">
                <div class="card-body">
                    {{ 'No QOTD found.'|trans }}
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="navigation">
        {{ ux_pagination(pagination) }}
    </div>
{% endblock %}
