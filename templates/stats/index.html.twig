{% extends 'base.html.twig' %}

{% set active = 'stats' %}

{% block title %}{{ 'Stats'|trans }}{% endblock %}

{% block body %}
    <div class="row mb-3">
        {% for type in enum_cases('App\\Stats\\UsersChartType') %}
            <div class="col-xl-4">
                <twig:UsersChart :type loading="defer" />
            </div>
        {% endfor %}
    </div>

    <div class="mb-3">
        <twig:CountOverPeriodChart loading="lazy" />
    </div>
{% endblock %}
