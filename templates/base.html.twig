<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="view-transition">
        {{ turbo_refreshes_with(method: 'morph', scroll: 'preserve') }}
        <title>{% block title %}QOTD{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {% block stylesheets %}
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body
        class="d-flex flex-column h-100"
        {{ stimulus_controller('keyboard-shortcuts', {
            shortcuts: enum_cases('App\\KeyboardShortcut\\KeyboardShortcut')|map(shortcut => shortcut.toStimulus()),
        }) }}
        {{ stimulus_action('keyboard-shortcuts', 'handle', 'keydown@window') }}
    >
        <main class="flex-shrink-0">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
            <div {{ stimulus_controller('hide-votes') }} class="container">
                {% block menu %}
                    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-2">
                        <div class="container-fluid">
                            <a class="navbar-brand" href="{{ url('qotd_index') }}" {{ tt('brand') }}>QOTD</a>
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                            {% set active = active ?? null %}
                            <div class="collapse navbar-collapse text-nowrap" id="navbarSupportedContent">
                                <ul class="navbar-nav me-auto">
                                    <li class="nav-item">
                                        <a class="nav-link {{ 'qotd_not_voted' == active ? 'active' }}" href="{{ url('qotd_index_not_voted') }}">🗳 {{ 'Not voted yet'|trans }} <twig:NotVotedCounter /></a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link {{ 'search' == active ? 'active' }}" href="{{ url('qotd_search') }}">🔍 {{ 'Search'|trans }}</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link {{ 'random' == active ? 'active' }}" href="{{ url('random') }}">🤷 {{ 'Random'|trans }}</a>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <button class="nav-link dropdown-toggle {{ active in ['my_top', 'qotd_flop', 'qotd_top'] ? 'active' }}" type="button" data-bs-toggle="dropdown" aria-expanded="false">🔝 {{ 'Rankings'|trans }}</button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item {{ 'qotd_top' == active ? 'active' }}" href="{{ url('qotd_index_top') }}">👍 {{ 'Top'|trans }}</a></li>
                                            <li><a class="dropdown-item {{ 'qotd_flop' == active ? 'active' }}" href="{{ url('qotd_index_flop') }}">👎 {{ 'Flop'|trans }}</a></li>
                                            <li><a class="dropdown-item {{ 'my_top' == active ? 'active' }}" href="{{ url('my_top') }}">⭐ {{ 'My top'|trans }}</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <button class="nav-link dropdown-toggle {{ active in ['awards', 'hall_of_fame', 'stats'] ? 'active' }}" type="button" data-bs-toggle="dropdown" aria-expanded="false">🏆 {{ 'Records'|trans }}</button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item {{ 'hall_of_fame' == active ? 'active' }}" href="{{ url('hall_of_fame') }}">📆 {{ 'Hall Of Fame'|trans }}</a></li>
                                            <li><a class="dropdown-item {{ 'awards' == active ? 'active' }}" href="{{ url('awards') }}">🏅 {{ 'Awards'|trans }}</a></li>
                                            <li><a class="dropdown-item {{ 'stats' == active ? 'active' }}" href="{{ url('stats') }}">📈 {{ 'Stats'|trans }}</a></li>
                                        </ul>
                                    </li>
                                </ul>
                                <ul class="navbar-nav">
                                    <li class="nav-item dropdown">
                                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ 'Settings'|trans }}">⚙️</button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="{{ path('keyboard_shortcuts') }}" data-turbo-frame="modal" title="h, ?">⌨️ {{ 'Keyboard shortcuts'|trans }}</a></li>
                                            {% for locale in app.enabled_locales|filter(locale => locale != app.request.locale) %}
                                                <li><a class="dropdown-item text-uppercase" href="{{ path('locale_switch', {locale: locale}) }}" data-turbo="false">🌐 {{ locale }}</a></li>
                                            {% endfor %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li class="px-3">
                                                <div class="form-check form-switch mb-0">
                                                    <input
                                                        class="form-check-input" type="checkbox" role="switch" id="hideVotesSwitch"
                                                        {{ stimulus_target('hide-votes', 'switch') }}
                                                        {{ stimulus_action('hide-votes', 'toggle', 'change') }}
                                                    >
                                                    <label class="form-check-label" for="hideVotesSwitch">
                                                        {{ 'Hide votes'|trans }}
                                                    </label>
                                                </div>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </nav>
                {% endblock %}

                {% block body %}{% endblock %}
            </div>
        </main>
        <div {{ stimulus_controller('modal') }} {{ stimulus_action('modal', 'visit', 'modal:visit@window') }}>
            <turbo-frame id="modal" {{ stimulus_target('modal', 'frame') }}></turbo-frame>
            <template {{ stimulus_target('modal', 'loadingTemplate') }}>
                <twig:LoadingModal />
            </template>
        </div>
        <div
            id="toast-container"
            class="toast-container position-fixed bottom-0 end-0 p-3"
        >
            <turbo-frame id="toasts">
            </turbo-frame>
        </div>
        {% if live_updates_enabled() %}
            {% set live_updates_votes_topic = constant('App\\Qotd\\LiveUpdates::VOTES_TOPIC') %}
            {% set live_updates_topics = live_updates_topics ?? [live_updates_votes_topic] %}
            {# "subscribe": one cookie grants the topics of every tab, whatever the last page rendered listens to #}
            <twig:Turbo:Stream:From
                :topics="live_updates_topics"
                :subscribe="[live_updates_votes_topic, constant('App\\Qotd\\LiveUpdates::LATEST_TOPIC')]"
                private
                :id="'private-' ~ live_updates_topics|join('-')|replace({':': '-'}) ~ '-stream'"
                data-turbo-permanent
            />
            {{ stream_notifications([constant('App\\Qotd\\LiveUpdates::NOTIFICATIONS_TOPIC')]) }}
        {% endif %}
    </body>
</html>
